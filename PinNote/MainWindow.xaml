<Window x:Class="PinNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PinNote.Models"
        Title="PinNote"
        Width="320" Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12.5"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <!-- 一条记录的模板 -->
        <DataTemplate x:Key="NoteTemplate" DataType="{x:Type models:NoteItem}">
            <Border x:Name="Row" Margin="0,1" Padding="7,6" CornerRadius="7"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 状态圆点：点一下在 待做 → 进行中 → 已完成 之间切换 -->
                    <Grid Grid.Column="0" x:Name="StatusBtn" Width="16" Height="16"
                          VerticalAlignment="Top" Margin="0,1,0,0"
                          Background="Transparent" Cursor="Hand"
                          ToolTip="{Binding StatusTip}"
                          MouseLeftButtonDown="Status_Click">
                        <Ellipse x:Name="Ring" Width="12" Height="12"
                                 Stroke="#7C828E" StrokeThickness="1.4" Fill="Transparent"/>
                        <Ellipse x:Name="Dot" Width="0" Height="0" Fill="#3B82F6"/>
                        <Path x:Name="Tick" Data="M0,3 L2.4,5.4 L6,1.2"
                              Stroke="#FFFFFF" StrokeThickness="1.4" Visibility="Collapsed"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="6" Height="6" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Top">
                        <TextBlock x:Name="Body" Text="{Binding Text}" TextWrapping="Wrap"
                                   FontSize="12.5" LineHeight="18"
                                   Foreground="{DynamicResource ThemeTextBrush}"/>
                        <TextBlock x:Name="Stamp" Text="{Binding TimeText}" FontSize="9.5"
                                   Margin="0,2,0,0" Opacity="0.75"
                                   Foreground="{DynamicResource ThemeSubBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="DelBtn" Width="18" Height="18" Opacity="0"
                            VerticalAlignment="Top" Focusable="False" Cursor="Hand"
                            ToolTip="删除" Click="Delete_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <TextBlock x:Name="Glyph" Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="8" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ThemeSubBrush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                                        <Setter TargetName="Glyph" Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Todo">
                    <Setter TargetName="Ring" Property="Stroke" Value="#F5A524"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Doing">
                    <Setter TargetName="Ring" Property="Stroke" Value="#3B82F6"/>
                    <Setter TargetName="Dot" Property="Width" Value="5"/>
                    <Setter TargetName="Dot" Property="Height" Value="5"/>
                    <Setter TargetName="Dot" Property="Fill" Value="#3B82F6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="Ring" Property="Fill" Value="#22C55E"/>
                    <Setter TargetName="Ring" Property="Stroke" Value="#22C55E"/>
                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Body" Property="TextDecorations" Value="Strikethrough"/>
                    <Setter TargetName="Body" Property="Opacity" Value="0.42"/>
                    <Setter TargetName="Stamp" Property="Opacity" Value="0.4"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeHoverBrush}"/>
                    <Setter TargetName="DelBtn" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 配色小圆点 -->
        <Style x:Key="SwatchRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Outer" Width="23" Height="23" Stroke="Transparent" StrokeThickness="1.4"/>
                            <Ellipse Width="15" Height="15" Fill="{Binding Swatch}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource ThemeTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="#8C8F98"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- ============ 展开态 ============ -->
        <Border x:Name="Shell" CornerRadius="14"
                Background="{DynamicResource ThemeBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部：拖动区 + 按钮 -->
                <Grid Grid.Row="0" Height="28" Margin="13,7,7,0" Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse Width="4.5" Height="4.5" Fill="#F5A524" Margin="0,0,7,0"/>
                        <TextBlock Text="{Binding PendingText}" FontSize="10.5"
                                   Foreground="{DynamicResource ThemeSubBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" ToolTip="设置"
                                Click="Settings_Click">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                        <Button x:Name="CollapseBtn" Style="{StaticResource IconButton}" ToolTip="收起来"
                                Margin="2,0,0,0" Click="Collapse_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 输入 -->
                <Border Grid.Row="1" Margin="12,5,12,2" CornerRadius="8"
                        Background="{DynamicResource ThemeFieldBrush}">
                    <Grid>
                        <TextBox x:Name="InputBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ThemeTextBrush}"
                                 CaretBrush="{DynamicResource ThemeTextBrush}"
                                 SelectionBrush="#4A3B82F6"
                                 FontSize="12.5" Padding="9,7" Margin="1"
                                 VerticalContentAlignment="Center"
                                 AcceptsReturn="False"
                                 TextChanged="InputBox_TextChanged"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"/>
                        <TextBlock x:Name="Placeholder" Text="记点什么，回车记下"
                                   Margin="11,0,0,0" FontSize="12.5" IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeSubBrush}" Opacity="0.65"/>
                    </Grid>
                </Border>

                <!-- 列表 -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="9,2,7,9" Focusable="False">
                        <ItemsControl x:Name="NoteList" ItemTemplate="{StaticResource NoteTemplate}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyHint" Text="空空的，写第一条吧"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11.5" IsHitTestVisible="False"
                               Foreground="{DynamicResource ThemeSubBrush}" Opacity="0.55"/>
                </Grid>

                <!-- 右下角调整大小 -->
                <Thumb x:Name="ResizeGrip" Grid.Row="2" Width="14" Height="14"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" DragDelta="Grip_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <!-- ============ 设置浮层 ============ -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#01000000"
              MouseLeftButtonDown="Overlay_Click">
            <Border x:Name="SettingsCard" CornerRadius="11" Margin="9" Padding="13,11"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ThemePanelBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    MouseLeftButtonDown="Card_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="透明度" FontSize="10.5" Foreground="{DynamicResource ThemeSubBrush}"/>
                        <TextBlock Text="{Binding OpacityLabel}" FontSize="10.5"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource ThemeSubBrush}"/>
                    </Grid>
                    <Slider x:Name="OpacitySlider" Style="{StaticResource FlatSlider}"
                            Minimum="20" Maximum="100" SmallChange="1" LargeChange="10"
                            ValueChanged="Opacity_Changed" Margin="0,0,0,9"/>

                    <TextBlock Text="颜色" FontSize="10.5" Margin="0,0,0,6"
                               Foreground="{DynamicResource ThemeSubBrush}"/>
                    <ItemsControl x:Name="ThemeList" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource SwatchRadio}"
                                             GroupName="ThemeSwatch" ToolTip="{Binding Name}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Checked="Theme_Checked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox x:Name="TopmostCheck" Style="{StaticResource FlatCheck}"
                              Content="总在最前" Margin="0,8,0,0" Click="Topmost_Click"/>
                    <CheckBox x:Name="AutoStartCheck" Style="{StaticResource FlatCheck}"
                              Content="开机自启" Margin="0,8,0,0" Click="AutoStart_Click"/>

                    <Grid Margin="0,9,0,0">
                        <Button x:Name="ClearDoneBtn" Content="清空已完成" Style="{StaticResource TextButton}"
                                HorizontalAlignment="Left" Padding="0,3" Click="ClearDone_Click"/>
                        <Button Content="退出" Style="{StaticResource TextButton}"
                                HorizontalAlignment="Right" Padding="0,3" Click="Exit_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 收起态 ============ -->
        <Border x:Name="MiniShell" Visibility="Collapsed" CornerRadius="14"
                Background="{DynamicResource ThemeBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="Expand_Click">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding PendingCount}" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource ThemeTextBrush}"/>
                <TextBlock Text="待做" FontSize="9" Margin="0,0,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource ThemeSubBrush}"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
